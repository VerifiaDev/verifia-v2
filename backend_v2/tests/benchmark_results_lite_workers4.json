  "harness_source": "\"\"\"Follow-up driver: reuse original benchmark fixture, sampler and watchdog unchanged.\"\"\"\nimport hashlib\nimport json\nimport platform\nfrom pathlib import Path\nimport runpy\nimport sys\n\nROOT = Path('.')\nBENCH = ROOT / 'backend_v2/tests/benchmark_lite_retrieval.py'\nOUT = ROOT / 'backend_v2/tests/benchmark_results_lite_workers4.json'\nORIGINAL = ROOT / 'backend_v2/tests/benchmark_results_lite.json'\nns = runpy.run_path(str(BENCH), run_name='offline_benchmark_helpers')\nif '--child' in sys.argv:\n    spec = json.loads(sys.argv[sys.argv.index('--child') + 1])\n    sys.path.insert(0, str(ROOT / 'backend_v2'))\n    from app.retrieval import _lite_workers\n    # Original harness calls search_detailed through to_thread to retain diagnostics.\n    # Explicitly supply the adapter invocation context; direct module calls now\n    # intentionally use the sequential path. No production function is patched.\n    token = _lite_workers.set(spec['workers_per_claim'])\n    try:\n        ns['child'](spec)\n    finally:\n        _lite_workers.reset(token)\n    raise SystemExit\n\nns['run_sample'].__globals__['__file__'] = __file__\noriginal_hash = hashlib.sha256(ORIGINAL.read_bytes()).hexdigest()\nproduction = ['backend_v2/app/retrieval.py', 'retrieval_demo_lite/search_retrieval_lite.py']\nhashes = {p: hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in production}\nreport = json.loads(OUT.read_text()) if OUT.exists() else {\n    'platform': {'os': platform.platform(), 'python': platform.python_version()},\n    'config': ns['CONFIG'], 'rss_units': 'MiB', 'raw_runs': [],\n    'original_results_sha256': original_hash,\n    'benchmark_source_sha256': hashlib.sha256(BENCH.read_bytes()).hexdigest(),\n    'production_hashes_before': hashes,\n    'harness_source': Path(__file__).read_text(),\n    'notes': ['Only new 4-worker large-body concurrency scenarios; old results untouched.',\n              'Original fixture, process isolation, RSS sampling and watchdog reused.',\n              'Invocation ContextVar supplied to detailed benchmark calls to enable instance worker policy.'],\n}\n\ndef save():\n    assert hashlib.sha256(ORIGINAL.read_bytes()).hexdigest() == original_hash\n    report['scenario_summary'] = ns['summarize'](report['raw_runs'])\n    report['production_hashes_after'] = {\n        p: hashlib.sha256((ROOT/p).read_bytes()).hexdigest() for p in production}\n    temp = OUT.with_suffix('.json.tmp')\n    temp.write_text(json.dumps(report, indent=2) + '\\n')\n    temp.replace(OUT)\n\nstop = False\nfor claims in (2, 3, 4):\n    name = f'S4x{claims}'\n    spec = {'scenario': name, 'claim_count': claims, 'workers_per_claim': 4,\n            'payload_bytes_per_page': ns['CONFIG']['large_payload_bytes'], 'tracemalloc': False}\n    if stop:\n        if not any(r['scenario'] == name for r in report['raw_runs']):\n            report['raw_runs'].append({**spec, 'result_status': 'skipped', 'reason': 'stress headroom guard'})\n            save()\n        continue\n    for repeat in (1, 2, 3):\n        existing = next((r for r in report['raw_runs'] if r['scenario']==name and r.get('repeat')==repeat),None)\n        if existing:\n            run = existing\n        else:\n            run = ns['run_sample'](spec, repeat)\n            report['raw_runs'].append(run)\n            save()\n            print(name, repeat, run['result_status'], 'latency',run.get('retrieval_latency_seconds'),\n                  'RSS',run.get('peak_sampled_rss_mb'), 'fetch',run.get('peak_active_fetches'),flush=True)\n        if max(run.get('peak_sampled_rss_mb') or 0, run.get('ru_maxrss_mb') or 0) >= ns['CONFIG']['stress_headroom_mb']:\n            stop = True\n        if run['result_status'] == 'aborted_by_memory_guard':\n            stop = True\n            break\nsave()\nprint(json.dumps(report['scenario_summary'],indent=2),flush=True)\n",
  "notes": [
    "Only new 4-worker large-body concurrency scenarios; old results untouched.",
    "Original fixture, process isolation, RSS sampling and watchdog reused.",
