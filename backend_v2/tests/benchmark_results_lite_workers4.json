  "production_hashes_before": {
    "backend_v2/app/retrieval.py": "6bba1fec156f189d11b4fb127f571c67575295f4c1e100a471e31fd12e790e10",
    "retrieval_demo_lite/search_retrieval_lite.py": "754e587c5e1f3ce88151d73b92dda5b5d6f8b59961ce4c6fd84a2d7c462b2b34"
